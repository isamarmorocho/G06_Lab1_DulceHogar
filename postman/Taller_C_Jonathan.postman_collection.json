                  "pm.test(\"Estado CONFIRMADO\", () => pm.expect(r.estado).to.eql(\"CONFIRMADO\"));",
                  "pm.test(\"El historial registra el cambio\", () => { pm.expect(r.historial).to.have.length(1); pm.expect(r.historial[0].estadoAnterior).to.eql(\"PENDIENTE\"); pm.expect(r.historial[0].nota).to.eql(\"Pago recibido\"); });"
                ]
