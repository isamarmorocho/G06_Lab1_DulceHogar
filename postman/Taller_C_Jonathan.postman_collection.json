            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Entrega un JWT\", () => pm.expect(r.token.split(\".\")).to.have.length(3));",
                  "pm.collectionVariables.set(\"adminToken\", r.token);"
