        {
          "name": "C0. Datos: id y stock inicial del Cupcake (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const c = r.find((p) => p.nombre === \"Cupcake de vainilla\");",
                  "pm.test(\"Existe el Cupcake\", () => pm.expect(c).to.exist);",
                  "pm.collectionVariables.set(\"cupcakeId\", c.id);",
                  "pm.collectionVariables.set(\"stockInicial\", c.stock);"
                ]
              }
            }
          ]
        },
        {
          "name": "C1. Ana crea un pedido de 1 cupcake (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
