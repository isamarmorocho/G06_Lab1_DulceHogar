                  "const r = pm.response.json();",
                  "pm.test(\"Nace PENDIENTE\", () => pm.expect(r.estado).to.eql(\"PENDIENTE\"));",
                  "pm.collectionVariables.set(\"pedidoCId\", r.id);"
