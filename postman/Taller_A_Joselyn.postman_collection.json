    {
      "name": "Taller · A · Reseñas · Joselyn Morocho",
      "item": [
        {
          "name": "A0. Obtener el id del Brownie (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const b = r.find((p) => p.nombre === \"Brownie\");",
                  "pm.test(\"Existe el Brownie\", () => pm.expect(b).to.exist);",
                  "pm.collectionVariables.set(\"brownieId\", b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "A1. Reseñar con compra entregada (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres/{{brownieId}}/resenas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "{{brownieId}}",
                "resenas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calificacion\": 5,\n  \"comentario\": \"Delicioso\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAna}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve la reseña\", () => { pm.expect(r.calificacion).to.eql(5); pm.expect(r.comentario).to.eql(\"Delicioso\"); });",
                  "pm.test(\"Es del postre correcto\", () => pm.expect(r.postreId).to.eql(Number(pm.collectionVariables.get(\"brownieId\"))));",
                  "pm.collectionVariables.set(\"resenaId\", r.id);"
                ]
              }
            }
          ]
        },
