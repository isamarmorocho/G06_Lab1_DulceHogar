              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Forma { postreId, promedio, total, page, limit, pages, data }\", () => pm.expect(r).to.include.all.keys(\"postreId\",\"promedio\",\"total\",\"page\",\"limit\",\"pages\",\"data\"));",
                  "pm.test(\"Promedio entre 1 y 5 (aggregate _avg)\", () => { pm.expect(r.promedio).to.be.within(1, 5); pm.expect(r.total).to.be.at.least(1); });",
                  "pm.test(\"Incluye el nombre del autor, sin contraseña\", () => { pm.expect(r.data[0].user.name).to.be.a(\"string\"); pm.expect(r.data[0].user).to.not.have.property(\"password\"); });"
                ]
              }
            }
