{
  "info": {
    "name": "G06_Lab2 · Persistencia con Prisma",
    "description": "Colección del Laboratorio 2. Renombra G06 con tu número de grupo y /api/postres con la ruta de tu entidad. Ejecuta con Run collection en orden. Requiere haber ejecutado npx prisma db seed (usa el registro «Brownie» para probar 409).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "CRUD con Prisma",
      "item": [
        {
          "name": "1. Listar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Arreglo desde PostgreSQL\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            }
          }
        },
        {
          "name": "2. Crear",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const item = pm.response.json();",
                  "pm.test(\"Tiene id y createdAt (los pone la BD)\", () => { pm.expect(item.id).to.exist; pm.expect(item.createdAt).to.exist; });",
                  "pm.collectionVariables.set(\"id\", item.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Postre de prueba {{$timestamp}}\",\n  \"precio\": 3.2,\n  \"stock\": 15,\n  \"categoria\": \"tortas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Ver uno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "{{id}}"
              ]
            }
          }
        },
        {
          "name": "4. Actualizar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Precio actualizado\", () => pm.expect(pm.response.json().precio).to.eql(3.5));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 3.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. Datos inválidos (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"precio\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Valor único repetido (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict por @unique\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Brownie\",\n  \"precio\": 2.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7. Inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "99999"
              ]
            }
          }
        },
        {
          "name": "8. Eliminar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "{{id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transacción (todo o nada)",
      "item": [
        {
          "name": "9. Contar antes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"antes\", pm.response.json().length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            }
          }
        },
        {
          "name": "10. Lote válido → COMMIT (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Creó 2 registros\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));",
                  "pm.collectionVariables.set(\"antes\", Number(pm.collectionVariables.get(\"antes\")) + 2);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres/lote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "lote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"nombre\": \"Lote A {{$timestamp}}\",\n    \"precio\": 1.0,\n    \"stock\": 5\n  },\n  {\n    \"nombre\": \"Lote B {{$timestamp}}\",\n    \"precio\": 2.0,\n    \"stock\": 5\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Lote con un ítem inválido → ROLLBACK (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres/lote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "lote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"nombre\": \"Debe deshacerse {{$timestamp}}\",\n    \"precio\": 1.0\n  },\n  {\n    \"nombre\": \"x\",\n    \"precio\": -5\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "12. Lote con nombre repetido → ROLLBACK (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/postres/lote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres",
                "lote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"nombre\": \"También se deshace {{$timestamp}}\",\n    \"precio\": 1.0\n  },\n  {\n    \"nombre\": \"Brownie\",\n    \"precio\": 2.5\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "13. Verificar ROLLBACK: nada quedó guardado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La cantidad es la misma que tras el COMMIT\", () => pm.expect(pm.response.json().length).to.eql(Number(pm.collectionVariables.get(\"antes\"))));",
                  "pm.test(\"No existe el primer ítem de los lotes fallidos\", () => pm.expect(pm.response.json().some(p => p.nombre.startsWith(\"Debe deshacerse\") || p.nombre.startsWith(\"También se deshace\"))).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/postres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "postres"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": "1"
    },
    {
      "key": "antes",
      "value": "0"
    }
  ]
}